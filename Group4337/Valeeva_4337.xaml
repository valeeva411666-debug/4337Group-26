<Window x:Class="Group4337.Valeeva_4337"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Group4337"
        mc:Ignorable="d"
        Title="Valeeva Азалия - Лабораторная работа №3" 
        Height="500" 
        Width="800">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
        <TextBlock Text="Азалия 18"/>

        <Button Content="Импорт из Excel"
                Click="ImportButton_Click"
                Height="30"
                Margin="10"/>

        <Button Content="Экспорт в Excel"
                Click="ExportButton_Click"
                Height="30"
                Margin="10"/>
        
        <Button Content="Импорт JSON"
                Click="ImportJson_Click"
                Height="30"
                 Margin="10"/>

        <Button Content="Экспорт в Word"
                Click="ExportWord_Click"
                Height="30"
                 Margin="10"/>
    </StackPanel>
</Window>